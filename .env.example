    # ============================================================
# SPORTZONE — Environment Configuration
# Sao chép file này thành .env rồi điền giá trị thực
# KHÔNG commit file .env vào git
# ============================================================

# --- Application ---
APP_NAME="SPORTZONE"
APP_ENV=development        # development | production
APP_DEBUG=true             # false trong production
APP_URL=http://localhost/sportzone/public
APP_KEY=CHANGE_ME_TO_RANDOM_32_CHAR_SECRET_KEY

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sportzone
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Session ---
SESSION_NAME=sz_session
SESSION_LIFETIME=7200          # seconds (2 giờ)
SESSION_SECURE=false           # true khi dùng HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@sportzone.vn
MAIL_FROM_NAME=SPORTZONE
MAIL_ENCRYPTION=tls

# --- File Upload ---
UPLOAD_MAX_SIZE=5242880        # 5MB in bytes
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,webp

# --- Rate Limiting ---
RATE_LIMIT_LOGIN=5             # max attempts
RATE_LIMIT_LOGIN_DECAY=300     # lockout seconds (5 phút)
RATE_LIMIT_CHECKOUT=10
RATE_LIMIT_WINDOW=60           # window in seconds

# --- Shipping ---
SHIPPING_FEE_DEFAULT=30000
SHIPPING_FREE_THRESHOLD=500000 # Miễn phí ship khi đơn >= 500k
