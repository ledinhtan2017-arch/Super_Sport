# ============================================================
# SPORTZONE — .gitignore
# ============================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local

# --- Storage (user uploads & logs) ---
storage/uploads/*
!storage/uploads/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep

# --- Composer ---
vendor/
composer.lock

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- PHP ---
*.log

# --- Backup files ---
*.bak
*.backup
*.sql.gz
